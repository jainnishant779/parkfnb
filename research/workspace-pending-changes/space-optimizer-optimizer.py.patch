+def _free_remainder(poly, placed, aprons):
+    """Polygon minus everything already claimed, as one biggest Polygon
+    (dropping slivers too thin for another stall) so the next ring can
+    pack against its own boundary instead of the original plot edge."""
+    if not placed:
+        return poly
+    remainder = poly.difference(unary_union(placed + aprons))
+    if remainder.is_empty:
+        return None
+    parts = ([remainder] if remainder.geom_type == "Polygon"
+             else [g for g in remainder.geoms if g.geom_type == "Polygon"])
+    parts = [p for p in parts if p.area > 1.0]
+    if not parts:
+        return None
+    return max(parts, key=lambda p: p.area)
+
