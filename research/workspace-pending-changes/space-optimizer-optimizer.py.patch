+def _strip_span(part, lo, hi, horizontal):
+    """The safe inner span of `part` across a strip: the tightest
+    [near, far] bound that clears the (possibly slanted) polygon edge
+    at BOTH ends of the strip, not just the strip's own bounding box —
+    so a box anchored here never pokes past a diagonal boundary."""
+    minx, miny, maxx, maxy = part.bounds
+    if horizontal:
+        lines = (LineString([(minx - 1, lo), (maxx + 1, lo)]),
+                 LineString([(minx - 1, hi), (maxx + 1, hi)]))
+    else:
+        lines = (LineString([(lo, miny - 1), (lo, maxy + 1)]),
+                 LineString([(hi, miny - 1), (hi, maxy + 1)]))
+    coord_idx = 0 if horizontal else 1
+    nears, fars = [], []
+    for line in lines:
+        inter = part.boundary.intersection(line)
+        geoms = list(inter.geoms) if hasattr(inter, "geoms") else [inter]
+        vals = [
+            c[coord_idx]
+            for g in geoms if not g.is_empty and g.geom_type in ("Point", "LineString")
+            for c in g.coords
+        ]
+        if not vals:
+            return None
+        nears.append(min(vals))
+        fars.append(max(vals))
+    near, far = max(nears), min(fars)
+    return (near, far) if far > near else None
