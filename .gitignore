# ---- dependencies -------------------------------------------------------
node_modules/

# ---- secrets ------------------------------------------------------------
.env
.env.local
.env.*.local
# Any file whose name ends in .env. Credential dumps get named things like
# atlas-credentials.env and are one careless "git add -A" from being published.
*.env
!.env.example
!**/ios/.xcode.env
*.keystore
!debug.keystore

# ---- Android build output (regenerated by Gradle) -----------------------
# Roughly 900 MB across the two apps if committed.
**/android/build/
**/android/app/build/
**/android/.gradle/
**/android/.cxx/
**/android/local.properties
*.apk
*.aab
*.hprof
hs_err_pid*.log
replay_pid*.log

# ---- iOS ----------------------------------------------------------------
**/ios/Pods/
**/ios/build/
**/ios/*.xcworkspace/xcuserdata/

# ---- uploads (KYC documents, listing photos) ----------------------------
# User data, not source. Moving to object storage before deploy.
services/backend/uploads/

# ---- Python -------------------------------------------------------------
__pycache__/
*.pyc
venv/
.venv/

# ---- editors / OS -------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- logs / temp --------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
~$*

# ---- Metro / RN ---------------------------------------------------------
.metro-health-check*
**/.expo/

# Backups that can carry secrets
*.env.bak
.env.bak

# Rendered videos and big exports — keep them out of git
*.mp4
temp_audio/
temp_hindi_audio/
