# =============================================================
#  ParkFNB backend — environment
#
#  Copy to .env and fill in. .env is gitignored; this file is not,
#  so never put a real secret here.
#
#  Every variable the code reads is listed. Ones marked REQUIRED
#  stop the server or a feature from working if left unset.
# =============================================================


# ---- Server -------------------------------------------------
NODE_ENV=development
PORT=5000

# Origins allowed by CORS, comma separated. The admin panel needs
# to be here or the browser blocks it. Any *.onrender.com origin
# is already allowed.
FRONTEND_URL=http://localhost:5173


# ---- Database (REQUIRED) ------------------------------------
# Atlas connection string, or a local mongod.
# The database name goes before the '?', e.g. .../parkfnb?retryWrites=true
MONGODB_URI=mongodb://127.0.0.1:27017/parkfnb


# ---- Auth (REQUIRED) ----------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d


# ---- OTP ----------------------------------------------------
# Local development only — NEVER set this in a deployed environment.
# It returns the OTP in the API response, so anyone could request a
# code for any phone number and sign in as that person. Left unset,
# the code is only printed to the server log.
ALLOW_DEV_OTP=true

# SMS delivery. Without SMS_PROVIDER the provider is "mock": the code is only
# printed to the server log and NO SMS is sent. The admin Settings values
# sms.provider / sms.api_key override these.
#   mock | msg91 | fast2sms | twilio
SMS_PROVIDER=msg91
# msg91: "<widgetId>:<tokenAuth>" from the MSG91 OTP widget. Set the widget's
# OTP length to 6 — both apps only accept a 6-digit code.
SMS_API_KEY=
# Alternative to putting the pair in SMS_API_KEY:
# MSG91_WIDGET_ID=
# MSG91_TOKEN_AUTH=

# Test OTP for development and pre-production (defaults to 123456).
# Set DISABLE_TEST_OTP=true once a real SMS provider is live.
TEST_OTP=123456
DISABLE_TEST_OTP=false


# ---- ANPR gate camera (REQUIRED for plate access) -----------
# Shared secret between the ANPR service and this backend. A camera
# has no user session, so the service authenticates with this token
# in the x-anpr-token header. The same value must be exported when
# starting the ANPR service:
#
#   ANPR_SERVICE_TOKEN=... uvicorn app:app --port 8008
#
# Without it, /api/access/anpr-event refuses every request.
ANPR_SERVICE_TOKEN=change-me-anpr-token


# ---- Physical barrier over Firebase -------------------------
# The arch-lock prototype polls a Firebase Realtime Database every
# two seconds rather than speaking MQTT. The backend mirrors every
# open/close there so the real barrier and the simulator both react.
#
# Leave FIREBASE_DATABASE_URL empty to disable the bridge entirely.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# Maps MQTT device ids to Firebase barrier ids — they are different
# namespaces. Format: mqttId:firebaseId, comma separated.
FIREBASE_DEVICE_MAP=pb-001:BARRIER_001

FIREBASE_BARRIER_ENABLED=true

# Only needed if the database rules require auth. Rules are currently
# open, which is why the device writes without one — lock this down
# before any pilot.
# FIREBASE_DATABASE_SECRET=


# ---- MQTT broker (device simulator) -------------------------
# Defaults to the public broker.hivemq.com:1883 when unset, which is
# fine for a simulator and not fine for real hardware.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
# MQTT_USER=
# MQTT_PASS=


# ---- Over-the-air updates -----------------------------------
# Signs OTA bundles. Only needed if you publish app updates.
# OTA_SECRET=


# ---- Demo seed ----------------------------------------------
# Read by scripts/seed-demo.js. The ALLOW plate must match the plate
# in the ANPR demo image exactly, or the allow case cannot work.
DEMO_ALLOW_PLATE=MH04DB6948
DEMO_DENY_PLATE=MH12AB1234
DEMO_DEVICE_ID=pb-001
DEMO_DEVICE_SECRET=change-me-to-a-long-random-string


# Node version is pinned in package.json engines.
