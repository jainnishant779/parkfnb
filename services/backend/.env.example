# Server
NODE_ENV=development
PORT=5000

# Kaunsa origin CORS ke liye allowed hai (admin panel ka dev URL)
FRONTEND_URL=http://localhost:5173

# MongoDB — Atlas connection string ya local mongod
MONGODB_URI=mongodb://127.0.0.1:27017/parkfnb

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Local development only — NEVER set this in a deployed environment.
# It returns the OTP in the API response, so anyone could request a code for
# any phone number and sign in as that person. Left unset, the code is only
# printed to the server log.
ALLOW_DEV_OTP=true

# Node version pinned for the host; also set in package.json engines.
