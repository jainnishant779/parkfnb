+def _gate_corridor(poly, gate, width, depth):
+    """Driveway rectangle from the gate straight into the plot, square to
+    the boundary edge the gate sits on. poly must be CCW (interior on the
+    left of each edge)."""
+    coords = list(poly.exterior.coords)
+    a, b = min(zip(coords, coords[1:]),
+               key=lambda e: LineString(e).distance(gate))
+    ex, ey = b[0] - a[0], b[1] - a[1]
+    L = math.hypot(ex, ey)
+    if L < 1e-9:
+        return None
+    tx, ty = ex / L, ey / L
+    nx, ny = -ty, tx
+    edge = LineString([a, b])
+    p = edge.interpolate(edge.project(gate))
+    hw = width / 2.0
+    return Polygon([
+        (p.x - tx * hw, p.y - ty * hw),
+        (p.x + tx * hw, p.y + ty * hw),
+        (p.x + tx * hw + nx * depth, p.y + ty * hw + ny * depth),
+        (p.x - tx * hw + nx * depth, p.y - ty * hw + ny * depth),
+    ])
