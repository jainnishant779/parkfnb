+/**
+ * POST /api/access/anpr-occupancy-event
+ * Header: x-anpr-token
+ * Body:   { event, camera_id, bay_id, plate, quality, straddles, encroachments, coverage, timestamp }
+ */
+exports.anprOccupancyEvent = async (req, res) => {
+  try {
+    const token = req.headers['x-anpr-token'];
+    const expected = process.env.ANPR_SERVICE_TOKEN;
+
+    if (!expected) {
+      return error(res, errorCodes.SERVER_ERROR, 500, 'ANPR_SERVICE_TOKEN is not configured on the server');
+    }
+    if (!token || token !== expected) {
+      return error(res, errorCodes.AUTH_FORBIDDEN, 401, 'Invalid or missing service token');
+    }
+
+    const { event, camera_id, bay_id, plate, quality, straddles, encroachments, coverage, timestamp } = req.body || {};
+    console.log(`[ANPR Occupancy Event] ${event} on bay ${bay_id} (camera: ${camera_id}): plate=${plate}, quality=${quality}`);
+
+    // If misparking or straddling violation, record in audit log
+    if (event === 'misparking' || quality === 'violation' || (straddles && straddles.length > 0)) {
+      try {
+        await AccessAuditLog.create({
+          device_id: camera_id || 'occupancy-cam',
+          parking_space_id: null,
+          booking_id: null,
+          user_id: SYSTEM_ACTOR,
+          user_role: 'system',
+          action: 'rejected',
+          success: false,
+          error_message: `ANPR: MISPARKING — Bay ${bay_id} violation [${(Array.isArray(straddles) ? straddles : []).join(', ')}] by ${plate || 'unknown vehicle'}`,
+          ip_address: req.ip || null,
+        });
+      } catch (auditErr) {
+        console.error('Failed to log misparking event:', auditErr.message);
+      }
+    }
+
+    return success(res, { received: true, event, bay_id });
+  } catch (err) {
+    console.error('anprOccupancyEvent error:', err);
+    return error(res, errorCodes.SERVER_ERROR, 500, err.message);
+  }
+};
