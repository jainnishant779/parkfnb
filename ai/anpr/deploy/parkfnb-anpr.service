[Unit]
Description=ParkFNB live ANPR (camera feed, bays, IN/OUT)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/parkfnb-anpr
EnvironmentFile=/etc/parkfnb-anpr.env
# 127.0.0.1 only: the public face is Caddy (HTTPS).  --no-access-log keeps the camera key, which
# travels in some query strings, out of the logs.
ExecStart=/opt/parkfnb-anpr/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8010 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=always
RestartSec=5
# A small box: if the model ever outgrows it, restart this service rather than let the whole
# machine thrash and lock up SSH.
MemoryHigh=1400M
MemoryMax=1700M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
